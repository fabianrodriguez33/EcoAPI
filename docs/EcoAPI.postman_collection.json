{
  "info": {
    "name": "EcoAPI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "tokenOperario",
      "value": ""
    },
    {
      "key": "tokenSupervisor",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenAlterado",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login operario1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/auth/login"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"usuario\": \"operario1\", \"contrasena\": \"Eco2026*\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('tokenOperario', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login supervisor1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/auth/login"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"usuario\": \"supervisor1\", \"contrasena\": \"Eco2026*\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('tokenSupervisor', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/auth/login"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"usuario\": \"admin\", \"contrasena\": \"Eco2026*\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('tokenAdmin', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "401 sin token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/rutas/dia"
        }
      }
    },
    {
      "name": "401 token alterado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenOperario}}x"
          }
        ],
        "url": {
          "raw": "{{base}}/rutas/dia"
        }
      }
    },
    {
      "name": "Ruta del dia",
      "request": {
        "method": "GET",
